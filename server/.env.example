# NOTE: Commented values have defaults, copy to .env and uncomment to override if needed

# Dataset Settings
# DATASET_RAW_DIR=/absolute/path/to/data/raw
# DATASET_CHUNK_SIZE=1048576
# DATASET_RECORD_URL=https://zenodo.org/api/records/10447705/files
# DATASET_SAMPLES_DIR=/absolute/path/to/data/samples

# Gemini Client Settings
GEMINI_API_KEY=     # REQUIRED

# GEMINI_MODEL=gemini-4-hydrogen
# GEMINI_MAX_OUTPUT_TOKENS=24000

# Evaluation Settings
# EVALUATION_RUNS_DIR=/absolute/path/to/data/runs
# EVALUATION_PAUSE_SECONDS=6.0

# Token-Probability Baseline Settings
# BASELINE_BASELINES_DIR=/absolute/path/to/data/baselines
# BASELINE_MODEL=Qwen/Qwen2.5-Coder-1.5B-Instruct
# BASELINE_LINE_BUDGET=70

# API Settings
# API_HOST=127.0.0.1
# API_PORT=8000
# API_CORS_ORIGINS=["http://localhost:5173"]
# API_DECISIONS_FILE=/absolute/path/to/data/decisions.jsonl
